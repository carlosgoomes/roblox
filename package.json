{
  "name": "realbux-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "build": "node --check public/app.js && node --check src/server.js && node --check api/index.js && node --check public/effects.js && node --check src/payments.js && node --check public/checkout-view.js",
    "assets:sync": "node --use-env-proxy scripts/sync-reference-assets.js",
    "db:check": "node --use-env-proxy scripts/check-account-database.js"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "qrcode": "1.5.4"
  }
}
