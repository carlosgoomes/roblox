{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": { "maxDuration": 30 }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "same-origin",
        "Content-Security-Policy": "default-src 'self'; img-src 'self' data: https://bloxrealm.com.br https://gnr-assets.centralcart.ai; style-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
      },
      "continue": true
    },
    { "src": "/api/([a-z]+)", "dest": "/api/index?route=$1" },
    { "handle": "filesystem" },
    { "src": "/api/.*", "status": 404 },
    { "src": "/.*\\.[^/]+$", "status": 404 },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
