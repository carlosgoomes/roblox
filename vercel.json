{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "same-origin",
        "Content-Security-Policy": "default-src 'self'; img-src 'self' data: https://www.facebook.com https://facebook.com; style-src 'self'; script-src 'self' 'sha256-CPUertIWSVQOumx5pphsjhM/VkTqNf75DoVLidrkaYU=' https://connect.facebook.net; connect-src 'self' https://www.facebook.com https://facebook.com https://connect.facebook.net; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
      },
      "continue": true
    },
    {
      "src": "/dist/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/assets/(.*\\.(?:svg|png|jpg|jpeg))",
      "headers": {
        "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800"
      },
      "continue": true
    },
    {
      "src": "/assets/optimized/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/api/([a-z]+)",
      "dest": "/api/index?route=$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/.*",
      "status": 404
    },
    {
      "src": "/.*\\.[^/]+$",
      "status": 404
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
